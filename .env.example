# Copy to .env and adjust for your machine. Every value has a sane default
# in ecg/config.py if you omit it.

# Absolute path to the extracted PTB-XL release - the folder that directly
# contains ptbxl_database.csv, records100/ and records500/.
ECG_DATASET_ROOT=C:/Users/Mubarak/Desktop/ECG-Files/dataset/ptb-xl-a-large-publicly-available-electrocardiography-dataset-1.0.3

# Reproducibility
ECG_RANDOM_SEED=42

# Preprocessing
ECG_WINDOW_SIZE=200
ECG_LEAD_INDEX=1
ECG_PEAK_HEIGHT_RATIO=0.35
ECG_MIN_RR_SECONDS=0.3

# Training
ECG_MAX_EPOCHS=60
ECG_BATCH_SIZE=64
ECG_LEARNING_RATE=0.0001
ECG_EARLY_STOPPING_PATIENCE=8
ECG_TRAIN_ABNORMAL_RATIO=3
# Stratified cap on training records (0 = no cap, use the full balanced
# training fold - can take hours per epoch on CPU with ~17k records).
ECG_TRAIN_MAX_RECORDS=4000

# Serving
ECG_MODEL_PATH=artifacts/models/rcnn_model.h5
ECG_MAX_UPLOAD_BYTES=5242880
ECG_APP_HOST=127.0.0.1
ECG_APP_PORT=5000
